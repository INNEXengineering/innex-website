---
import { getCollection, render } from 'astro:content';
import EntryLayout from '../../layouts/EntryLayout.astro';

export async function getStaticPaths() {
  const services = await getCollection('services');
  const byId = new Map((await getCollection('caseTypes')).map((e) => [e.id, e]));
  return services.map((entry) => ({
    params: { slug: entry.id },
    // Resolve in frontmatter order; reference() already guarantees every id exists.
    props: { entry, related: entry.data.related.map((r) => byId.get(r.id)!) },
  }));
}
const { entry, related } = Astro.props;
const { Content } = await render(entry);
---
<EntryLayout entry={entry} related={related} section={{ name: 'Consulting', href: '/services/' }} consulting>
  <Content />
</EntryLayout>
