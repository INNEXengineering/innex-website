---
import { Image } from 'astro:assets';
import logo from '../assets/innex-logo.png';
import { SITE } from '../site.config';

const NAV = [
  { href: '/expert-witness/', label: 'Expert Witness' },
  { href: '/case-types/', label: 'Case Types' },
  { href: '/services/', label: 'Consulting' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="container bar">
    <a href="/" class="brand" aria-label="INNEX Engineering home">
      <Image src={logo} alt="INNEX Engineering logo" height={44} densities={[1, 2]} loading="eager" />
    </a>
    <div class="actions">
      <a class="btn call" href={SITE.phoneHref} aria-label={`Call ${SITE.phone}`}>
        <span class="call-short" aria-hidden="true">Call</span><span class="call-full" aria-hidden="true">Call {SITE.phone}</span>
      </a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" hidden>
        <span class="visually-hidden">Menu</span>
        <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2"/></svg>
      </button>
    </div>
    <nav id="site-nav" aria-label="Main">
      <ul>
        {NAV.map((n) => (
          <li><a href={n.href} aria-current={path === n.href ? 'page' : path.startsWith(n.href) ? 'true' : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: var(--ink); color: var(--paper); border-bottom: 3px solid var(--green); }
  .bar { display: flex; align-items: center; gap: 1rem 1.5rem; min-height: 4.25rem; flex-wrap: wrap; }
  .brand { margin-right: auto; }
  .brand img { width: auto; height: 44px; }
  .actions { order: 2; display: flex; align-items: center; gap: 0.5rem; }
  nav { order: 1; display: flex; align-items: center; }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; }
  nav a { color: var(--paper); text-decoration: none; font-weight: 600; padding-block: 0.25rem; border-bottom: 2px solid transparent; }
  nav a:hover, nav a[aria-current] { border-bottom-color: var(--green); color: var(--paper); }
  .call { padding: 0.6rem 1rem; white-space: nowrap; }
  .call-short { display: none; }
  .nav-toggle { display: none; background: none; border: 0; color: var(--paper); padding: 0.5rem; cursor: pointer; }
  @media (max-width: 860px) {
    .call-short { display: inline; }
    .call-full { display: none; }
    nav { order: 3; width: 100%; }
    :global(html.js) .nav-toggle { display: block; }
    :global(html.js) nav { display: none; padding-bottom: 1rem; }
    :global(html.js) nav.open { display: flex; }
    :global(html.js) ul { flex-direction: column; }
  }
</style>

<script is:inline>
  (() => {
    const btn = document.querySelector('.nav-toggle');
    const nav = document.getElementById('site-nav');
    if (!btn || !nav) return;
    btn.hidden = false;
    const set = (open) => {
      nav.classList.toggle('open', open);
      btn.setAttribute('aria-expanded', String(open));
    };
    btn.addEventListener('click', () => set(!nav.classList.contains('open')));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nav.classList.contains('open')) {
        set(false);
        btn.focus();
      }
    });
  })();
</script>
